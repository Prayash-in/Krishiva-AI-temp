# ---------------------------------------------------------------------------
# Krishiva AI — backend / engine configuration
# Copy to `.env` and fill in. Loaded automatically by the backend and engine.
# ---------------------------------------------------------------------------

# LLM provider: auto | anthropic | openai_compat | extractive
#   auto          -> Anthropic if ANTHROPIC_API_KEY is set, else extractive.
#   openai_compat -> a local OpenAI-compatible server (LM Studio / Ollama / vLLM).
#   extractive    -> no LLM; stitches an answer from the knowledge base.
KRISHIVA_LLM_PROVIDER=openai_compat

# --- Local model (LM Studio / Ollama / vLLM) — used when provider=openai_compat ---
# LM Studio's local server. (Ollama: http://localhost:11434/v1)
KRISHIVA_LLM_BASE_URL=http://localhost:1234/v1
# The model identifier as shown in LM Studio (Developer tab / server logs),
# e.g. "qwen/qwen3-4b" or "qwen3-4b". Set this to what YOUR LM Studio reports.
KRISHIVA_LLM_MODEL=qwen/qwen3-4b
# LM Studio ignores the key, but the client sends one anyway.
KRISHIVA_LLM_API_KEY=lm-studio
KRISHIVA_LLM_MAX_TOKENS=1500
# Inject "/no_think" for reasoning models like Qwen3 (keeps answers fast/clean).
KRISHIVA_LLM_DISABLE_THINKING=1

# --- Anthropic (only used when provider=anthropic) ---
ANTHROPIC_API_KEY=

# --- Retrieval / knowledge ---
KRISHIVA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Cross-encoder reranker for hybrid (dense + BM25) candidates. Leave empty to
# disable reranking and use the fusion order directly.
KRISHIVA_RERANKER_MODEL=BAAI/bge-reranker-base
KRISHIVA_TOP_K=6
# KRISHIVA_KB_DIR=data/knowledge
# KRISHIVA_VECTOR_STORE_PATH=data/vector_store
# KRISHIVA_COLLECTION_NAME=krishiva_kb

# --- Backend ---
# Set to 0 to force the deterministic stub engine instead of the real one.
KRISHIVA_USE_REAL_ENGINE=1
KRISHIVA_LOG_LEVEL=INFO
# KRISHIVA_CORS_ORIGINS=["http://localhost:3000"]
